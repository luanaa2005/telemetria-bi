	column 'Situação dos servidores'
		dataType: string
		lineageTag: 860ed5cd-7877-4355-ad60-5cc4fd7fc1b7
		summarizeBy: none
		sourceColumn: Situação dos servidores

		annotation SummarizationSetBy = Automatic

	partition 'Visão Gerencial' = m
		mode: import
		source = ```
				let
				    Source = telemetria,
				    WithNivel = Table.AddColumn(Source, "Nível",
				        each if [Unidade] = [Subunidade] then "UNIDADE" else "SUBUNIDADE"),
				    WithTotal = Table.AddColumn(WithNivel, "_total",
				        each [#"M365 E5"] + [Copilot] + [#"M365 F3"] + [#"M365 F5 Security"]),
				    Grouped = Table.Group(WithTotal, {"Nível", "Unidade", "Subunidade"}, {
				        {"U1 — Autoridades — licenças",
				            each List.Sum(Table.SelectRows(_, each [Qualidade] = "AUTORIDADE")[_total]),
				            Int64.Type},
				        {"U2 — Servidores — licenças",
				            each List.Sum(Table.SelectRows(_, each [Qualidade] = "SERVIDOR")[_total]),
				            Int64.Type},
				        {"U3 — Terceiros — licenças",
				            each List.Sum(Table.SelectRows(_, each [Qualidade] = "TERCEIRIZADO")[_total]),
				            Int64.Type},
				        {"U4 — Estagiários — licenças",
				            each List.Sum(Table.SelectRows(_, each [Qualidade] = "ESTAGIARIO")[_total]),
				            Int64.Type},
				        {"Total de licenças",
				            each List.Sum(_[_total]),
				            Int64.Type},
				        {"Ociosas",
				            each Table.RowCount(Table.SelectRows(_, each
				                ([Situação funcional] = "INATIVO" or [Situação funcional] = "NAO_INFORMADO") and
				                ([#"M365 E5"] = 1 or [Copilot] = 1))),
				            Int64.Type},
				        {"Situação dos servidores",
				            each if Table.RowCount(Table.SelectRows(_, each [Situação funcional] = "INATIVO" and [_total] > 0)) > 0 then "Atenção" else "OK",
				            type text}
				    })
				in
				    Grouped
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


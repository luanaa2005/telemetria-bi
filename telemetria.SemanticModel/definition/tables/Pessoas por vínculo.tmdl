	partition 'Pessoas por vínculo' = m
		mode: import
		source =
				let
				    Source = telemetria,
				    WithTotal = Table.AddColumn(Source, "Total de licenças",
				        each [#"M365 E5"] + [Copilot] + [#"M365 F3"] + [#"M365 F5 Security"],
				        Int64.Type)
				in
				    WithTotal

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

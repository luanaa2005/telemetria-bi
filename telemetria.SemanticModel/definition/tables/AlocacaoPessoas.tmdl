	partition AlocacaoPessoas = m
		mode: import
		source = ```
				let
				    Source = telemetria,
				    WithNivel = Table.AddColumn(Source, "Nível",
				        each if [Unidade] = [Subunidade] then "UNIDADE" else "SUBUNIDADE"),
				    Classificacao = Table.AddColumn(WithNivel, "Classificação", each
				        if ([Situação funcional] = "INATIVO" or [Situação funcional] = "NAO_INFORMADO") and ([#"M365 E5"] = 1 or [Copilot] = 1) then "Ociosa"
				        else if ([#"M365 E5"] = 1 or [Copilot] = 1) and [Situação funcional] = "ATIVO" then "Ativa"
				        else "Sem licença")
				in
				    Classificacao
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


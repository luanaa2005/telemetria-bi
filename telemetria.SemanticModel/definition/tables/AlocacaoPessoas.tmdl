table AlocacaoPessoas
	lineageTag: 2ec14cbe-2d39-40ae-a6c7-0f6058a901de

	measure 'Total Licenças' = COUNTROWS(AlocacaoPessoas)
		formatString: 0
		lineageTag: 821e6228-5cdb-4f56-a040-8f56df3355d0

	measure 'Licenças Ativas' = CALCULATE(COUNTROWS(AlocacaoPessoas), AlocacaoPessoas[Classificação] = "Ativa")
		formatString: 0
		lineageTag: 88c75ba8-cbfb-461d-87e1-5f618f4dac07

	measure LicencasOciosas = CALCULATE(COUNTROWS(AlocacaoPessoas), AlocacaoPessoas[Classificação] = "Ociosa")
		formatString: 0
		lineageTag: c46904ab-af5a-48ce-9bb2-6ed44def20b8

	measure 'Total E5' = SUM(AlocacaoPessoas[M365 E5])
		formatString: 0
		lineageTag: a1b2c3d4-e5f6-7890-aa11-bb22cc33dd44

	measure 'Total Copilot' = SUM(AlocacaoPessoas[Copilot])
		formatString: 0
		lineageTag: b2c3d4e5-f6a7-8901-bb22-cc33dd44ee55

	measure 'Total F3' = SUM(AlocacaoPessoas[M365 F3])

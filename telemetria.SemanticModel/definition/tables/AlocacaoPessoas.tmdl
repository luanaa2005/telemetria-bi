	measure 'Total F5 Security' = SUM(AlocacaoPessoas[M365 F5 Security])
		formatString: 0
		lineageTag: d4e5f6a7-b8c9-0123-dd44-ee55ff66aa77

	measure '% Ativas' = DIVIDE([Licenças Ativas], [Licenças Ativas] + [LicencasOciosas])
		formatString: 0%
		lineageTag: e5f6a7b8-c9d0-1234-ee55-ff66aa77bb88

	measure 'Data Coleta' = FORMAT(MAX(AlocacaoPessoas[Data da coleta]), "DD/MM/YYYY")

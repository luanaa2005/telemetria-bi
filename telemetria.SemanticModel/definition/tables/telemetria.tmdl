	partition telemetria = m
		mode: import
		source =
				let
				    Source = Folder.Files("\\ger-sinet\telemetria"),
				    ExcelOnly = Table.SelectRows(Source, each [Extension] = ".xlsx"),
				    Sorted = Table.Sort(ExcelOnly, {{"Date modified", Order.Descending}}),
				    LatestFile = Sorted{0}[Content],
				    Workbook = Excel.Workbook(LatestFile, null, true)
				in
				    Workbook


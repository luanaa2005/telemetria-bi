	partition telemetria = m
		mode: import
		source =
				let
				    Source = File.Contents(CaminhoPasta & "\fake-data.csv"),
				    Csv = Csv.Document(Source, [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Normalized = Table.TransformColumns(Headers, {
				        {"UPN", each Text.Lower(Text.Trim(_)), type text},
				        {"Qualidade", each Text.Upper(Text.Trim(_)), type text},
				        {"Situação funcional", each Text.Upper(Text.Trim(_)), type text},
				        {"Conta", each Text.Proper(Text.Trim(_)), type text}
				    }),
				    TypedNums = Table.TransformColumnTypes(Normalized, List.Transform(CatalogoProdutos[ColunaOrigem], each {_, Int64.Type})),
				    Typed = Table.TransformColumns(TypedNums, {{"Data da coleta", each DateTime.From(DateTimeZone.From(_)), type datetime}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

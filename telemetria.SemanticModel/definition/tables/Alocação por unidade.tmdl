		annotation SummarizationSetBy = Automatic

	partition 'Alocação por unidade' = m
		mode: import
		source = ```
				let
				    Source = telemetria,
				    WithNivel = Table.AddColumn(Source, "Nível",
				        each if [Unidade] = [Subunidade] then "UNIDADE" else "SUBUNIDADE"),
				    Grouped = Table.Group(WithNivel, {"Nível", "Unidade", "Subunidade"}, {
				        {"E5 total",
				            each List.Sum(_[#"M365 E5"]),
				            Int64.Type},
				        {"Copilot",
				            each List.Sum(_[Copilot]),
				            Int64.Type},
				        {"E5 terceiros",
				            each List.Sum(Table.SelectRows(_, each [Qualidade] = "TERCEIRIZADO")[#"M365 E5"]),
				            Int64.Type},
				        {"% E5 em terceiros",
				            each if List.Sum(_[#"M365 E5"]) = 0 then 0.0
				                 else List.Sum(Table.SelectRows(_, each [Qualidade] = "TERCEIRIZADO")[#"M365 E5"]) / List.Sum(_[#"M365 E5"]),
				            type number},
				        {"Pessoas E5/Copilot",
				            each Table.RowCount(Table.SelectRows(_, each [#"M365 E5"] = 1 or [Copilot] = 1)),
				            Int64.Type},
				        {"E5 terceiros: conta desabilitada",
				            each Table.RowCount(Table.SelectRows(_, each [Qualidade] = "TERCEIRIZADO" and [#"M365 E5"] = 1 and [Conta] = "Desabilitada")),
				            Int64.Type},
				        {"E5 terceiros: situação INATIVO",
				            each Table.RowCount(Table.SelectRows(_, each [Qualidade] = "TERCEIRIZADO" and [#"M365 E5"] = 1 and [#"Situação funcional"] = "INATIVO")),
				            Int64.Type},
				        {"E5 terceiros: situação ausente/outro",
				            each Table.RowCount(Table.SelectRows(_, each [Qualidade] = "TERCEIRIZADO" and [#"M365 E5"] = 1 and [#"Situação funcional"] <> "ATIVO" and [#"Situação funcional"] <> "INATIVO")),
				            Int64.Type}
				    }),
				    WithCusto = Table.AddColumn(Grouped, "Custo anual E5 + Copilot",
				        each [#"E5 total"] * 3120.60 + [Copilot] * 2590.08, type number)
				in
				    WithCusto
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

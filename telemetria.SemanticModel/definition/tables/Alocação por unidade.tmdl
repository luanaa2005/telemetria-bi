table 'Alocação por unidade'
	lineageTag: ea0641a8-db2f-4202-b657-e5ca666e8596

	measure 'E5 Total' = CALCULATE(SUM('Alocação por unidade'[E5 total]), 'Alocação por unidade'[Nível] = "UNIDADE")
		formatString: 0
		lineageTag: a1b2c3d4-e5f6-7890-a1b2-c3d4e5f6a7b8

	measure 'E5 Terceiros' = CALCULATE(SUM('Alocação por unidade'[E5 terceiros]), 'Alocação por unidade'[Nível] = "UNIDADE")
		formatString: 0
		lineageTag: b2c3d4e5-f6a7-8901-b2c3-d4e5f6a7b8c9

	measure '% E5 Terceiros' = DIVIDE([E5 Terceiros], [E5 Total])
		formatString: 0%
		lineageTag: c3d4e5f6-a7b8-9012-c3d4-e5f6a7b8c9d0

	measure '% E5 Terceiros Color' = IF([% E5 Terceiros] >= 0.5, "#ED7373", IF([% E5 Terceiros] >= 0.25, "#FAC775", "#44C088"))
		lineageTag: d4e5f6a7-b8c9-0123-d4e5-f6a7b8c9d0e1

	measure 'Copilot Total' = CALCULATE(SUM('Alocação por unidade'[Copilot]), 'Alocação por unidade'[Nível] = "UNIDADE")
		formatString: 0
		lineageTag: e5f6a7b8-c9d0-1234-e5f6-a7b8c9d0e1f2

	measure 'Custo Anual Total' = CALCULATE(SUM('Alocação por unidade'[Custo anual E5 + Copilot]), 'Alocação por unidade'[Nível] = "UNIDADE")
		formatString: R$ #,##0
		lineageTag: f6a7b8c9-d0e1-2345-f6a7-b8c9d0e1f2a3


model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["telemetria","dim Nível","Visão Gerencial","Pessoas por vínculo","Alocação por unidade","Preços","AlocacaoPessoas","CaminhoPasta","DimConta","DimEmpresa","DimOrganizacao","DimProduto","DimVinculo","FatoContas","FatoLicencas","Indicadores","27-10-2026-inventarioLicOffice365-050041","DimCombinacao"]

annotation PBI_ProTooling = ["DevMode"]

ref table telemetria
ref table 'dim Nível'
ref table 'Visão Gerencial'
ref table 'Pessoas por vínculo'
ref table 'Alocação por unidade'
ref table Preços
ref table AlocacaoPessoas
ref table 27-10-2026-inventarioLicOffice365-050041
ref table DimCombinacao
ref table DimConta
ref table DimEmpresa
ref table DimOrganizacao
ref table DimProduto
ref table DimVinculo
ref table FatoContas
ref table FatoLicencas
ref table Indicadores

ref cultureInfo en-US
ref cultureInfo pt-BR

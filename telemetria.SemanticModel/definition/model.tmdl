model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CaminhoPasta","CatalogoProdutos","telemetria","DimConta","DimEmpresa","DimOrganizacao","DimProduto","DimVinculo","FatoContas","FatoLicencas","Indicadores","DimCombinacao"]

annotation PBI_ProTooling = ["DevMode"]

ref table telemetria
ref table DimCombinacao
ref table DimConta
ref table DimEmpresa
ref table DimOrganizacao
ref table DimProduto
ref table DimVinculo
ref table FatoContas
ref table FatoLicencas
ref table Indicadores

ref cultureInfo en-US
ref cultureInfo pt-BR
